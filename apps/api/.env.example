# Supabase → Project Settings → Database → Connection string
# "Transaction" pooler (porta 6543, via pgbouncer) — usado em runtime pela API.
DATABASE_URL="postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (porta 5432) — usada só pelo Prisma para rodar migrations.
DIRECT_URL="postgresql://postgres.xxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

JWT_SECRET="troque-por-um-segredo-forte-antes-de-produzir"
PORT=3333
COSMOS_API_KEY=""
